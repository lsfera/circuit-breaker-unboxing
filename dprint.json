{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": ["**/*.{ts,tsx,js,jsx}"],
  "indentWidth": 2,
  "lineWidth": 120,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "always",
    "quoteStyle": "alwaysDouble",
    "trailingCommas": "never",
    "operatorPosition": "maintain",
    "arrowFunction.useParentheses": "force"
  },
  "excludes": [
    "LLMS.md",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/docs",
    "**/coverage",
    "**/*.tsbuildinfo",
    "**/CHANGELOG.md",
    "**/.*",
    "!.vscode",
    "!.vscode/**/*"
  ],
  "plugins": ["https://plugins.dprint.dev/typescript-0.93.4.wasm"]
}
