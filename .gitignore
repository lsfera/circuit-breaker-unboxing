node_modules/
.pnpm-store/
.DS_Store
*.log

# Personal overrides for infra/incident.mjs's service URLs — e.g. the
# service-hostname (http://rabbitmq:15672, ...) a devcontainer sibling
# container needs instead of the localhost defaults that work from a real
# host machine. Never committed: the right value depends on where you run
# the script from, not on this repo.
.env.local
_site/
docs/_site/
docs/.bundle/
docs/vendor/
docs/assets/vendor/

# Instrumentation records (infra/instrument.mjs). One run each, so they
# accumulate; the baselines the documentation quotes are kept, the rest are
# yours to delete.
history/runs/*.json
!history/runs/baseline-*.json

# Reference source, fetched at the installed version by scripts/fetch-effect.mjs.
repos/
