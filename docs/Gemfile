# Jekyll 4, not the `github-pages` gem, and the reason is `render_with_liquid`.
#
# These documents are written for GitHub first. Two of them contain `{{ ... }}`
# that is not Liquid: a `docker inspect -f '{{.HostConfig.RestartPolicy.Name}}'`
# in operations.md, and mermaid's hexagon-node syntax in journey.md and
# rmq-control-plane.md. Rendered through Liquid, the first becomes
# `docker inspect -f ''` — a broken command presented as a working one — and the
# second stops being a diagram. `{% raw %}` would fix the site by putting literal
# markers into what GitHub shows, which is the wrong way round.
#
# Jekyll 4 can switch Liquid off per page; the `github-pages` gem pins Jekyll 3,
# which cannot. So the site builds from a workflow instead of from the /docs
# setting. See .github/workflows/pages.yml.
source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "kramdown-parser-gfm", "~> 1.1"

group :jekyll_plugins do
  gem "jekyll-relative-links", "~> 0.7"
  gem "jekyll-optional-front-matter", "~> 0.3"
  gem "jekyll-titles-from-headings", "~> 0.5"
  # Serves runbooks/README.md at /runbooks/, the way GitHub serves a folder.
  gem "jekyll-readme-index", "~> 0.3"
end
