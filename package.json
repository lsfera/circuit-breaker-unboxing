{
  "name": "egress-breaker-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "start": "node --experimental-strip-types packages/aggregator/src/main.ts",
    "test": "node --experimental-strip-types --test 'packages/*/test/*.test.ts'",
    "test:redis": "pnpm --filter @egress/aggregator test:redis",
    "test:rmq": "pnpm --filter @egress/rmq test:rmq",
    "typecheck": "tsc --noEmit",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "check:links": "node scripts/check-site-links.mjs",
    "check:vendored": "node scripts/check-vendored.mjs",
    "check": "pnpm run check:vendored && pnpm run typecheck && pnpm run test",
    "subscribe": "node --experimental-strip-types packages/subscriber/src/subscriber.ts",
    "demo": "node --experimental-strip-types packages/demo/src/driver.ts",
    "measure": "node infra/instrument.mjs",
    "measure:idle": "node infra/instrument.mjs idle --seconds=60",
    "demo:envoy": "AGGREGATOR=http://127.0.0.1:8088,http://127.0.0.1:8089 FAILURE_MODE=envoy FLAKY_UPSTREAM=http://127.0.0.1 PROMETHEUS=http://127.0.0.1:9090 node --experimental-strip-types packages/demo/src/driver.ts",
    "site": "docker build -f docs/Dockerfile -t egress-site . && docker run --rm -p ${SITE_PORT:-4000}:80 egress-site",
    "site:build": "docker build -f docs/Dockerfile -t egress-site ."
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "jsdom": "^30.0.1",
    "mermaid": "12.0.0",
    "typescript": "^7.0.2"
  }
}
