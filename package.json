{
  "name": "egress-breaker-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "test": "node --test 'packages/*/test/*.test.ts'",
    "test:rmq": "pnpm --filter @egress/rmq test:rmq && pnpm --filter @egress/rmq-consumer test:rmq",
    "typecheck": "tsc --noEmit",
    "fetch:effect": "node scripts/fetch-effect.mjs",
    "check:vendored": "node scripts/fetch-effect.mjs && node scripts/check-vendored.mjs",
    "check": "pnpm run check:vendored && pnpm run typecheck && pnpm run test",
    "incident": "node infra/incident.mjs",
    "format": "dprint fmt"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "dprint": "^0.58.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
