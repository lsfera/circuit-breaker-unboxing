{
  "name": "egress-breaker-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "node --test 'packages/*/test/*.test.ts'",
    "test:rmq": "pnpm --filter @egress/rmq test:rmq",
    "typecheck": "tsc --noEmit",
    "check:vendored": "node scripts/check-vendored.mjs",
    "check": "pnpm run check:vendored && pnpm run typecheck && pnpm run test",
    "incident": "node infra/incident.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
