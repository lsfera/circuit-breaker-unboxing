{
  "name": "egress-breaker-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "start": "node packages/aggregator/src/main.ts",
    "test": "node --test 'packages/*/test/*.test.ts'",
    "test:redis": "pnpm --filter @egress/aggregator test:redis",
    "test:rmq": "pnpm --filter @egress/rmq --filter @egress/rmq-consumer test:rmq",
    "typecheck": "tsc --noEmit",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "check:vendored": "node scripts/check-vendored.mjs",
    "check": "pnpm run check:vendored && pnpm run typecheck && pnpm run test",
    "subscribe": "node packages/subscriber/src/subscriber.ts",
    "demo": "node packages/demo/src/driver.ts",
    "measure": "node infra/instrument.mjs",
    "measure:idle": "node infra/instrument.mjs idle --seconds=60",
    "demo:envoy": "AGGREGATOR=http://127.0.0.1:8088,http://127.0.0.1:8089 FAILURE_MODE=envoy FLAKY_UPSTREAM=http://127.0.0.1 PROMETHEUS=http://127.0.0.1:9090 node packages/demo/src/driver.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "mermaid": "12.0.0",
    "typescript": "^7.0.2"
  }
}
