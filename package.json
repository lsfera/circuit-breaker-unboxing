{
  "name": "egress-breaker-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "test": "vitest run --project 'unit:*'",
    "test:bun": "bun --bun vitest run --project 'unit:*'",
    "test:deno": "deno run -A node_modules/vitest/vitest.mjs run --project 'unit:*'",
    "test:rmq": "vitest run --project 'integration:*'",
    "test:rmq:bun": "bun --bun vitest run --project 'integration:*'",
    "test:rmq:deno": "deno run -A node_modules/vitest/vitest.mjs run --project 'integration:*'",
    "test:runtimes": "pnpm run test && pnpm run test:bun && pnpm run test:deno",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint packages",
    "fetch:effect": "node scripts/fetch-effect.mjs",
    "check:vendored": "node scripts/fetch-effect.mjs && node scripts/check-vendored.mjs",
    "check": "pnpm run check:vendored && pnpm run lint && pnpm run typecheck && pnpm run test",
    "incident": "node infra/incident.mjs",
    "format": "dprint fmt"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "dprint": "^0.58.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
