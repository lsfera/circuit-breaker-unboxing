  {
   "id": 13,
   "type": "state-timeline",
   "title": "Aggregator leadership",
   "description": "Which aggregator instance currently holds the publishing lease. Exactly one line should read leader at a time; a docker kill of the leader should flip this to the other instance within lease_ttl_ms, with no gap in the state timeline above.",
   "gridPos": {
    "x": 0,
    "y": 46,
    "w": 18,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "egress_aggregator_is_leader",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "standby",
         "color": "grey"
        },
        "1": {
         "text": "leader",
         "color": "green"
