  {
   "id": 14,
   "type": "stat",
   "title": "Fencing conflicts",
   "description": "Checkpoint writes rejected because a newer lease holder already took over. A clean, fast failover (e.g. a hard process kill) typically never triggers this \u2014 it's the safety net for a slower one, such as a GC pause outliving the lease.",
   "gridPos": {
    "x": 18,
    "y": 46,
    "w": 6,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
