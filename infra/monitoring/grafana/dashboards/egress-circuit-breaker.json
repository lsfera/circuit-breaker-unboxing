    "query": "prometheus",
    "current": {},
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 15,
   "type": "row",
   "title": "Circuit breaker \u2014 the published verdict",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 1,
   "type": "state-timeline",
   "title": "Published state per API",
   "description": "What subscribers see: one gapless line per API, coloured by the currently published breaker state. This is the console's replica strip already resolved to a single fleet-wide answer.",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "egress_circuit_state",
     "legendFormat": "{{apiId}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "CLOSED",
         "color": "green"
        },
        "1": {
         "text": "DEGRADED",
         "color": "yellow"
        },
        "2": {
         "text": "OPEN",
         "color": "red"
        },
        "3": {
         "text": "HALF_OPEN",
         "color": "blue"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "always"
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Published transitions",
   "description": "One point per state_changed event, by reason. Should be a handful per incident, not a storm \u2014 that's dwellMs/minStateMs debouncing working.",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (apiId, state, reason) (increase(egress_circuit_transitions_total[$__interval]))",
     "legendFormat": "{{apiId}} -> {{state}} ({{reason}})",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Healthy / total endpoints",
   "description": "Fleet-averaged. Watch payments-provider's healthy line collapse to 0 while total stays put as you drag the failure rate up.",
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "egress_circuit_healthy_endpoints",
     "legendFormat": "{{apiId}} healthy",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "egress_circuit_total_endpoints",
     "legendFormat": "{{apiId}} total",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2
     }
    },
    "overrides": []
   }
  },
  {
   "id": 31,
   "type": "row",
   "title": "Daemon fleet \u2014 what the consumers decide and call",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 19,
   "type": "state-timeline",
   "title": "Circuit state, as each daemon sees it",
   "description": "The aggregator's published state (top of this dashboard) is the truth; these are the five independent views of it that arrived over circuit.control. They should be indistinguishable. A line that stops moving while the others transition is a daemon that has gone deaf.",
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "egress_daemon_circuit_state",
     "refId": "A",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "CLOSED",
         "color": "green"
        },
        "1": {
         "text": "DEGRADED",
         "color": "orange"
        },
        "2": {
         "text": "OPEN",
         "color": "red"
        },
        "3": {
         "text": "HALF_OPEN",
         "color": "blue"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "mergeValues": true,
    "showValue": "always"
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Fleet: agreed target vs actually pulling",
   "description": "The panel a deaf daemon shows up on. Every daemon derives the same target from the same events, so `max` is the agreed number; `sum` of self_active is how many are really holding a work connection. The two lines track each other. When they do not, some daemon has stopped hearing the control plane while still looking healthy \u2014 the failure that took a whole session to find by hand. Pulling is the work queue's consumer count as RabbitMQ reports it; in HALF_OPEN it is the one prober.",
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max(egress_daemon_target_fraction) * count(egress_daemon_target_fraction)",
     "refId": "A",
     "legendFormat": "agreed target"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rabbitmq_detailed_queue_consumers{queue=~\".*[.]work\"})",
     "refId": "B",
     "legendFormat": "daemons actually pulling"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "count(egress_daemon_target_fraction)",
     "refId": "C",
     "legendFormat": "fleet size"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "lineInterpolation": "stepAfter"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Third-party calls through the egress listener",
   "description": "Arrival rate against completion rate. The producer never backs off, on purpose, so the distance between published and ok+failed is exactly what accumulates in the queue above.",
   "gridPos": {
    "x": 12,
    "y": 26,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rate(rabbitmq_detailed_queue_exchange_messages_published_total{queue=~\".*[.]work\"}[1m]))",
     "refId": "A",
     "legendFormat": "published onto work (RabbitMQ)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rate(egress_daemon_calls_total[1m])) by (outcome)",
     "refId": "B",
     "legendFormat": "{{outcome}}/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2
     }
    },
    "overrides": []
   }
  },
  {
   "id": 20,
   "type": "stat",
   "title": "AMQP contract: gaps",
   "description": "The same per-API sequence guarantee /api/subscriber checks over HTTP, checked again on the AMQP transport by five processes the publisher does not control. Should stay 0 through an entire incident, failovers included.",
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(egress_daemon_control_gaps_total)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 21,
   "type": "stat",
   "title": "AMQP contract: duplicates",
   "description": "A repeated state_changed sequence seen on circuit.control. Snapshots deliberately repeat and are not counted. Non-zero here is what a leader resuming from a stale in-memory sequence would look like from outside.",
   "gridPos": {
    "x": 12,
    "y": 34,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(egress_daemon_control_duplicates_total)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 25,
   "type": "row",
   "title": "RabbitMQ \u2014 the work queues, as the broker reports them",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 27,
   "type": "stat",
   "title": "Ready work nobody is taking",
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 8,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "Messages ready on the work queue while it has consumers and acked nothing in the last minute \u2014 consumers that are registered but not being delivered to. RabbitMQ's consumer_capacity cannot show this: it reads 0 for every quorum queue.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
     "expr": "(sum(rabbitmq_detailed_queue_messages_ready{queue=~\".*[.]work\"}) > 0 and sum(rabbitmq_detailed_queue_consumers{queue=~\".*[.]work\"}) > 0 and sum(rate(rabbitmq_detailed_queue_messages_acked_total{queue=~\".*[.]work\"}[1m])) == 0) or vector(0)",
     "legendFormat": "stalled ready messages"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 22,
   "type": "stat",
   "title": "Dead letters now",
   "description": "What is sitting in <apiId>.work.dead right now, what has been parked as poison, and how many messages the broker dead-lettered in the last minute. Read from RabbitMQ, so it survives daemon restarts. A non-zero dead-letter depth during an outage is expected; one that stays non-zero once the circuit is CLOSED means recovery is not happening.",
   "gridPos": {
    "x": 8,
    "y": 40,
    "w": 8,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rabbitmq_detailed_queue_messages{queue=~\".*work.dead\"}) or vector(0)",
     "refId": "A",
     "legendFormat": "in dead-letter queue"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rabbitmq_detailed_queue_messages{queue=~\".*work.parked\"}) or vector(0)",
     "refId": "B",
     "legendFormat": "parked"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(rabbitmq_global_messages_dead_lettered_delivery_limit_total[1m])) or vector(0)",
     "refId": "C",
     "legendFormat": "dead-lettered, last minute"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "orientation": "auto"
   }
  },
  {
   "id": 23,
   "type": "stat",
   "title": "Deliveries held by the fleet",
   "description": "Messages RabbitMQ has handed to consumers and not yet had settled \u2014 calls in flight, sheds being held, retries being republished. Bounded by prefetch \u00d7 consumers.",
   "gridPos": {
    "x": 16,
    "y": 40,
    "w": 8,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
     "expr": "sum(rabbitmq_detailed_queue_messages_unacked{queue=~\".*[.]work\"})",
     "legendFormat": "unacked"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Work queue depth",
   "description": "The single most legible thing this fleet does. The work queue fills while the circuit is OPEN and no daemon is pulling, then drains as the ramp brings daemons back \u2014 the gap between the two is the thundering herd that never happened. The dead-letter queue is where calls that failed ended up, rather than being silently accepted.",
   "gridPos": {
    "x": 0,
    "y": 45,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rabbitmq_detailed_queue_messages{queue=~\".*work\"}",
     "refId": "A",
     "legendFormat": "{{queue}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rabbitmq_detailed_queue_messages{queue=~\".*work.dead\"}",
     "refId": "B",
     "legendFormat": "{{queue}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rabbitmq_detailed_queue_consumers{queue=~\".*work\"}",
     "refId": "C",
     "legendFormat": "{{queue}} consumers"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  },
  {
   "id": 24,
   "type": "timeseries",
   "title": "Work queue flow",
   "description": "Every number here is the broker's own count, so it survives daemon restarts and includes what no application sees: redeliveries after a consumer died, dead-lettering the broker does at x-delivery-limit, and the redrive's moves. Published onto work includes retries and redrives as well as new arrivals.",
   "gridPos": {
    "x": 12,
    "y": 45,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
     "legendFormat": "published onto work",
     "expr": "sum(rate(rabbitmq_detailed_queue_exchange_messages_published_total{queue=~\".*[.]work\"}[1m]))"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "B",
     "legendFormat": "acked from work",
     "expr": "sum(rate(rabbitmq_detailed_queue_messages_acked_total{queue=~\".*[.]work\"}[1m]))"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "C",
     "legendFormat": "redelivered from work",
     "expr": "sum(rate(rabbitmq_detailed_queue_messages_redelivered_total{queue=~\".*[.]work\"}[1m]))"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "D",
     "legendFormat": "dead-lettered by the broker (delivery limit)",
     "expr": "sum(rate(rabbitmq_global_messages_dead_lettered_delivery_limit_total[1m]))"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "E",
     "legendFormat": "published onto dead-letter",
     "expr": "sum(rate(rabbitmq_detailed_queue_exchange_messages_published_total{queue=~\".*[.]work[.]dead\"}[1m])) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "F",
     "legendFormat": "moved out of dead-letter (redrive)",
     "expr": "sum(rate(rabbitmq_detailed_queue_messages_acked_total{queue=~\".*[.]work[.]dead\"}[1m])) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "G",
     "legendFormat": "parked",
     "expr": "sum(rate(rabbitmq_detailed_queue_exchange_messages_published_total{queue=~\".*[.]work[.]parked\"}[1m])) or vector(0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  },
  {
   "id": 26,
   "type": "timeseries",
   "title": "Ready vs held",
   "gridPos": {
    "x": 0,
    "y": 53,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "Ready is waiting for a consumer; unacked is held by one. Ready climbing while unacked sits at prefetch \u00d7 consumers is a fleet at its ceiling; ready climbing with unacked at zero is a fleet not taking work.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
     "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_ready{queue=~\".*[.]work\"})",
     "legendFormat": "{{queue}} ready"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "B",
     "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_unacked{queue=~\".*[.]work\"})",
     "legendFormat": "{{queue}} unacked"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "C",
     "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{queue=~\".*[.]work[.]dead\"})",
     "legendFormat": "{{queue}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "D",
     "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{queue=~\".*[.]work[.]parked\"})",
     "legendFormat": "{{queue}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  },
  {
   "id": 28,
   "type": "timeseries",
   "title": "Dead-lettered, by reason and strategy",
   "gridPos": {
    "x": 12,
    "y": 53,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "Node-wide, from RabbitMQ's global counters. dead_letter_strategy=\"disabled\" is a queue with no dead-letter target reaching a limit: the broker dropped those messages.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
