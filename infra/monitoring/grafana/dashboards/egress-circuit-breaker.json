  {
   "id": 15,
   "type": "row",
   "title": "RabbitMQ daemon fleet",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 52,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Work queue depth",
   "description": "The single most legible thing this fleet does. The work queue fills while the circuit is OPEN and no daemon is pulling, then drains as the ramp brings daemons back \u2014 the gap between the two is the thundering herd that never happened. The dead-letter queue is where calls that failed ended up, rather than being silently accepted.",
   "gridPos": {
    "x": 0,
    "y": 53,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rabbitmq_detailed_queue_messages{queue=~\".*work\"}",
     "refId": "A",
     "legendFormat": "{{queue}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rabbitmq_detailed_queue_messages{queue=~\".*work.dead\"}",
     "refId": "B",
     "legendFormat": "{{queue}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "rabbitmq_detailed_queue_consumers{queue=~\".*work\"}",
     "refId": "C",
     "legendFormat": "{{queue}} consumers"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Fleet: agreed target vs actually pulling",
   "description": "The panel a deaf daemon shows up on. Every daemon derives the same target from the same events, so `max` is the agreed number; `sum` of self_active is how many are really holding a work connection. The two lines track each other. When they do not, some daemon has stopped hearing the control plane while still looking healthy \u2014 the failure that took a whole session to find by hand.",
   "gridPos": {
    "x": 12,
    "y": 53,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max(egress_daemon_target_active)",
     "refId": "A",
     "legendFormat": "agreed target"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(egress_daemon_self_active)",
     "refId": "B",
     "legendFormat": "daemons actually pulling"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max(egress_daemon_fleet_size)",
     "refId": "C",
     "legendFormat": "fleet size"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "lineInterpolation": "stepAfter"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Third-party calls through the egress listener",
   "description": "Arrival rate against completion rate. The producer never backs off, on purpose, so the distance between published and ok+failed is exactly what accumulates in the queue above.",
   "gridPos": {
    "x": 0,
    "y": 61,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rate(egress_producer_published_total[1m]))",
     "refId": "A",
     "legendFormat": "published/s"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rate(egress_daemon_calls_total[1m])) by (outcome)",
     "refId": "B",
     "legendFormat": "{{outcome}}/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2
     }
    },
    "overrides": []
   }
  },
