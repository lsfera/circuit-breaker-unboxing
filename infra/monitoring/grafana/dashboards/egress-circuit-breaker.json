  {
   "id": 12,
   "type": "timeseries",
   "title": "Envoy, per replica: healthy hosts (raw)",
   "description": "Direct from each Envoy's own admin stats, unaggregated \u2014 the disagreement the aggregator exists to resolve. Compare against the fleet-averaged line above: this one legitimately jumps around per replica during a partial failure; the published state does not.",
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
