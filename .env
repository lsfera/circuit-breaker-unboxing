# Defaults for docker-compose.yml's variable substitution. Docker Compose
# loads this file automatically; an actual exported HOST_WORKSPACE_FOLDER
# (e.g. set by a devcontainer) still takes precedence over this default.
#
# Bind-mount source for services that need host-shared paths — see the note
# at the top of docker-compose.yml. Defaults to "." (the directory compose
# is run from) for plain host use; devcontainers must export the real host
# path themselves, since "." inside the devcontainer isn't a host path.
HOST_WORKSPACE_FOLDER=.
